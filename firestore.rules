rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSuperAdmin() {
      return uid() == 'unZtDSytjOXGpCB21jKeicWWkMG3';
    }

    // Lectura segura del rol: devuelve 'user' si el documento no existe aún.
    function getRole() {
      return exists(/databases/$(database)/documents/user_roles/$(uid()))
        ? get(/databases/$(database)/documents/user_roles/$(uid())).data.role
        : 'user';
    }

    function isAdmin() {
      return isSuperAdmin() || getRole() in ['admin', 'super_admin'];
    }

    // ── Sets de fotos ───────────────────────────────────────────────────────
    // Cada usuario ve y modifica únicamente sus propios sets.
    // Los admins pueden leer todos (para futuras vistas de supervisión).
    match /photo_sets/{setId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == uid() || isAdmin());

      allow create: if isAuthenticated()
                    && request.resource.data.userId == uid();

      allow update, delete: if isAuthenticated()
                            && (resource.data.userId == uid() || isAdmin());
    }

    // ── Roles de usuario ────────────────────────────────────────────────────
    match /user_roles/{userId} {
      // Un usuario puede leer su propio rol; admins leen todos.
      allow read: if isAuthenticated()
                  && (uid() == userId || isAdmin());

      // Creación: ocurre al primer login (auto-registro como 'user') o cuando
      // un admin crea un usuario nuevo vía createUserAccount() — en ese flujo
      // la sesión es temporal del usuario recién creado.
      // Para mayor seguridad, migrar createUserAccount() a una Cloud Function.
      allow create: if isAuthenticated() && uid() == userId;

      // Solo admins pueden cambiar roles.
      // Nadie puede crear ni editar el rol 'super_admin'.
      allow update: if isAuthenticated()
                    && isAdmin()
                    && resource.data.role != 'super_admin'
                    && request.resource.data.role != 'super_admin';

      // Solo el super_admin puede eliminar documentos de roles.
      allow delete: if isAuthenticated() && isSuperAdmin();
    }

    // ── Invitaciones ────────────────────────────────────────────────────────
    match /invitations/{inviteId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
  }
}
